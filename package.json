{
  "name": "al-sheikh-office",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Al-Sheikh Office — commercial transportation, fleet and contract management",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c yellow,cyan \"tsx server/index.ts\" \"vite\"",
    "dev:api": "tsx server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "db:seed": "tsx server/seed-demo.ts",
    "db:reset": "tsx server/seed-demo.ts --reset",
    "typecheck": "tsc --noEmit",
    "test": "node tests/seed.mjs && node tests/integration.mjs && node tests/smoke.mjs",
    "test:integration": "node tests/integration.mjs",
    "test:smoke": "node tests/smoke.mjs",
    "test:postgres": "node tests/postgres-driver.mjs",
    "verify": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource/noto-kufi-arabic": "^5.2.8",
    "@tanstack/react-query": "^5.90.5",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.1.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4",
    "recharts": "^3.2.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electric-sql/pglite-socket": "^0.2.14",
    "@tailwindcss/vite": "^4.1.14",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^4.17.23",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.8.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
