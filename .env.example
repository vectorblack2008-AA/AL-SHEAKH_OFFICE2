# ---------------------------------------------------------------------------
# Al-Sheikh Office — environment variables
# Copy this file to `.env` for local development.
# ---------------------------------------------------------------------------

# HTTP port of the Express API (the Vite dev server proxies to it).
PORT=3001
NODE_ENV=development

# Session signing key. REQUIRED in production; the API refuses to start without
# it when NODE_ENV=production.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Leave DATABASE_URL empty for local development: the app then uses the
# embedded PGlite engine and persists to ./data/alsheikh.
#
# In production (and always on Vercel) provide a hosted PostgreSQL connection
# string, e.g. Neon or Supabase:
#   DATABASE_URL=postgresql://user:password@host/db?sslmode=require
#
# On Neon, use the pooled "-pooler" host for serverless deployments.
DATABASE_URL=

# Optional: local PGlite folder (only used when DATABASE_URL is empty).
# DATABASE_PATH=./data/alsheikh

# Set to "disable" only for a local PostgreSQL server without TLS.
# PGSSLMODE=disable

# Maximum PostgreSQL connections per process (defaults: 3 serverless, 10 local).
# PGPOOL_MAX=3

# ---------------------------------------------------------------------------
# First-run accounts
# ---------------------------------------------------------------------------
# Password for the built-in administrator (admin@alsheikh.eg) the first time
# the database is initialised.
#
# Development: optional — falls back to the local demo password Admin@12345.
# Production:  REQUIRED. The server refuses to create the first admin without
# it, and the value must be at least 12 characters with upper-case, lower-case,
# a number and a symbol. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
INITIAL_ADMIN_PASSWORD=

# Optional read-only viewer (viewer@alsheikh.eg). In production the account is
# only created when this is set, so fresh deployments never ship a known
# default credential. Same strength rules as the admin password.
INITIAL_VIEWER_PASSWORD=

# ---------------------------------------------------------------------------
# Business rules
# ---------------------------------------------------------------------------
# Timezone used to resolve "today" for dashboards, overdue checks and invoices.
SHOP_TIMEZONE=Africa/Cairo
